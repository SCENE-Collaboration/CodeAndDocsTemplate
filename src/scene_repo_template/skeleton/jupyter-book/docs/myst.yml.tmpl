# Jupyter Book 2 configuration: https://jupyterbook.org
# Preview locally with `jupyter book start`; build with `jupyter book build --html`.
version: 1
project:
  title: "$title"
  description: "$description"
  github: $github_url
  license: ${license}
  # No `toc:`: every page in docs/ is built and listed, in alphabetical order. Add a `toc:` to set the order.
  # _static/ holds parts of the theme (the footer), not pages.
  exclude:
    - _static/**

site:
  template: book-theme
  options:
    logo: images/scene-logo.png
    logo_text: SCENE
    favicon: images/favicon.png
    style: _static/scene.css
  parts:
    primary_sidebar_footer: _static/footer.md
